raw `
LittlerootTown_BrendansHouse_1F_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, LittlerootTown_BrendansHouse_1F_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, LittlerootTown_BrendansHouse_1F_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, LittlerootTown_BrendansHouse_1F_OnFrame
	.byte 0

LittlerootTown_BrendansHouse_1F_OnLoad:
	end

LittlerootTown_BrendansHouse_1F_OnTransition:
	end

LittlerootTown_BrendansHouse_1F_OnFrame:
	.2byte 0
`

script moisesaEntrandoEmCena {
	lockall
    playBGM(MUS_MOISESA_THEME, TRUE)
	playse(SE_DOOR)
	delay(10)
	applymovement(1, moves(walk_up))
	waitmovement(1)
	applymovement(1, MoisesaAndando)
	waitmovement(1)
	delay(30)
	setspeaker("MOISESA")
	msgbox("Bom dia, {PLAYER}!
	        Voce dormiu bem?
			Voce esta se sentindo bem?")
	delay(30)
	msgbox("Voce recebeu as noticias? 
	        Voce passou no pokémon!

			Voce vai receber seu 
			primeiro POKÉMON hoje!")
	delay(30)
	msgbox("uhuul!")
    applymovement(1, moves(jump_in_place_up))
	playse(SE_LEDGE)
	waitmovement(1)
	applymovement(1, moves(jump_in_place_up))
	playse(SE_LEDGE)
	delay(60)
	msgbox("O senhor que ira te entregar 
	        seu POKÉMON esta no 
			laboratiorio novo ao lado")
	delay(30)
	msgbox("Veja se um dos seus amigos também
	        passaram novestibular para buscar
			o POKÉMON de vocês juntos!")
	delay(30)
	closemessage
	applymovement(1, MoisesaIndoPraMesa)
	waitmovement(1)
    setvar(VAR_SANTANA_TOWN_STATE, 2)
	clearflag(FLAG_HIDE_SANTANA_TOWN_NPC)
	setflag(FLAG_HIDE_SANTANA_MOISESA)
	playBGM(MUS_SANTANA, TRUE)
	releaseall
}

movement MoisesaAndando {
	walk_up
	walk_right * 5
	walk_up * 3
}

movement MoisesaIndoPraMesa {
	walk_left * 6
	walk_up
	walk_left
	walk_down
	face_left
}

script moisesFala {
	lockall
	faceplayer
	if (var(VAR_SANTANA_TOWN_STATE) == 2) {
        msgbox("Teste1")
	} elif (var(VAR_SANTANA_TOWN_STATE) == 3) {
		msgbox("Teste2")
	} else {
		msgbox("Teste3")
	}
	closemessage
	face_left
	releaseall
}