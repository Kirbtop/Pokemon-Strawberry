raw `
LittlerootTown_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, LittlerootTown_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, LittlerootTown_OnFrame
	@ map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, LittlerootTown_OnWarp
	.byte 0

LittlerootTown_OnTransition:
	setflag FLAG_VISITED_LITTLEROOT_TOWN
	call_if_eq VAR_LITTLEROOT_INTRO_STATE, 0, LittlerootTown_EventScript_NovoJogo_PararMusica
	end

LittlerootTown_OnFrame:
	map_script_2 VAR_LITTLEROOT_INTRO_STATE, 0, LittlerootTown_EventScript_NovoJogo
	.2byte 0
`

script LittlerootTown_EventScript_NovoJogo {
    lockall
	fadescreen(FADE_TO_BLACK)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, ComoAssim)
	delay(100)
	fadescreen(FADE_FROM_BLACK)
	delay(10)
    playbgm(MUS_LITTLEROOT_TEST, TRUE)
	applymovement(OBJ_EVENT_ID_CAMERA, ComoAssim3)
	delay(100)
	opendoor(31, 31)
    delay(10)
	setobjectxy(1, 31, 31)
	delay(10)
	applymovement(1, MoisesaSaindo)
	waitmovement(0)
	delay(10)
	setobjectxy(2, 31, 31)
	delay(10)
	applymovement(2, MatiasSaindo)
	waitmovement(0)
	closedoor(31, 31)
	delay(100)
	setvar(VAR_0x8000, 1)
    callnative(DrawMugshot)
	callnative(FadeMugshotEntrace)
	delay(230)
	callnative(FadeMugshot)
	delay(100)
	callnative(ClearMugshot)
	delay(40)
	applymovement(1, MoisesaPulando)
	delay(70)
	applymovement(2, MatiasSaindo2)
	applymovement(OBJ_EVENT_ID_CAMERA, ComoAssim2)
	setvar(VAR_0x8000, 2)
    callnative(DrawMugshot)
	callnative(FadeMugshotEntrace)
	delay(230)
	callnative(FadeMugshot)
	delay(100)
	callnative(ClearMugshot)
	delay(120)
	setvar(VAR_0x8000, 0)
    callnative(DrawMugshot)
	callnative(FadeMugshotEntrace)
	delay(400)
	callnative(FadeMugshot)
	delay(100)
	callnative(ClearMugshot)
	setobjectxy(3, 7, 41)
	delay(10)
	applymovement(3, MoisesaEntrando)
	waitmovement(0)
	delay(30)
	opendoor(7, 31)
	applymovement(3, MoisesaEntrarPorta)
	waitmovement(0)
	delay(10)
	setobjectxy(3, 31, 31)
	delay(10)
	closedoor(7, 31)
	delay(20)
	fadescreen(FADE_TO_BLACK)
	special(RemoveCameraObject)
	setvar(VAR_LITTLEROOT_INTRO_STATE, 1)
	delay(20)
	warp(MAP_LITTLEROOT_TOWN, 7, 32)
	waitstate
    fadescreen(FADE_FROM_BLACK)
	releaseall
	end
}

script LittlerootTown_EventScript_NovoJogo_PararMusica {
	playbgm(MUS_RG_TITLE, TRUE)
	end
}

movement ComoAssim {
	walk_faster_right * 6
	walk_faster_down * 20
}

movement ComoAssim2 {
	walk_slow_left * 24
}

movement ComoAssim3 {
	walk_slow_left * 6
}

movement MoisesaSaindo {
	walk_down
	walk_left
	face_right
}

movement MatiasSaindo {
	walk_down
	face_left
}

movement MoisesaPulando {
	jump_in_place_right
	jump_in_place_right
	walk_fast_left * 23
	walk_up * 3
}

movement MatiasSaindo2 {
	walk_right * 10
}

movement MoisesaEntrando {
	walk_up * 9
}

movement MoisesaEntrarPorta {
	walk_up
}